/// Realmart retail sales fact table with embedded project data.
table Realmart_Sales
	lineageTag: 52fba6b9-7950-4de2-bfd0-af331fd209ad

	measure 'Total Sales' = SUM(Realmart_Sales[Total])
		formatString: #,##0.00
		lineageTag: ef28b118-fb35-43ee-af3e-80111c6df6e9

	measure 'Total Transactions' = COUNTROWS(Realmart_Sales)
		formatString: #,##0
		lineageTag: 66cac02a-3fb4-43e2-afde-81039da280a8

	measure 'Average Rating' = AVERAGE(Realmart_Sales[Rating])
		formatString: 0.00
		lineageTag: 9893b0c1-8840-4c08-a138-549f5b862865

	measure 'Average Transaction Value' = AVERAGE(Realmart_Sales[Total])
